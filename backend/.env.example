# Desarrollo local. Nunca usar esta clave en producción.
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=development-only-change-this-key-before-using-real-data
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=facturador
DB_USER=facturador
DB_PASSWORD=change-this-local-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Fracxion <no-reply@localhost>
# REDIS_URL=redis://127.0.0.1:6379/1
