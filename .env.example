# Variables de Docker Compose para producción. Copiar a .env y completar.
SITE_DOMAIN=facturador.example.com
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DEFAULT_FROM_EMAIL=Fracxion <no-reply@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
# Dedicated Fernet key(s), newest first. Keep old keys until seeds are re-encrypted.
MFA_ENCRYPTION_KEYS=
