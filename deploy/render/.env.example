# Referencia para el panel de Render. No copiar a Git valores reales.
DJANGO_SETTINGS_MODULE=config.render_settings
DJANGO_ENV=production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
MFA_ENCRYPTION_KEYS=
FRACXION_PROXY_SECRET=
# Copiar de Neon (Postgres 17), conexión pooled, conservando sslmode=require.
DATABASE_URL=
# Conexión interna del Key Value Free, en la misma región que Django.
REDIS_URL=
# Render provee RENDER_EXTERNAL_HOSTNAME automáticamente.
TRUST_PROXY_HTTPS=False
CORS_ALLOWED_ORIGINS=https://SUBDOMINIO-REAL.netlify.app
CSRF_TRUSTED_ORIGINS=https://SUBDOMINIO-REAL.netlify.app
FRONTEND_PASSWORD_RESET_URL=https://SUBDOMINIO-REAL.netlify.app/reset-password
DJANGO_EMAIL_BACKEND=config.email_backend.BrevoEmailBackend
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=Fracxion <REMITENTE-VERIFICADO>
